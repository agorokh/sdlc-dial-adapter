            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"dial-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"adapter_metrics\" and r._field == \"end_to_end_p95_ms\")\n  |> filter(fn: (r) => r.target_model_family != \"none\" and r.target_model_family != \"unknown\")\n  |> group(columns: [\"target_model_family\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "End-to-end p95 latency by family",
      "type": "timeseries"
