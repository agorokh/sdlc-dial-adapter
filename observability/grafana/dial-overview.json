      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"dial-metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"analytics\" and r._field == \"prompt_tokens\")\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> elapsed(unit: 1ms)\n  |> filter(fn: (r) => exists r.elapsed)\n  |> map(fn: (r) => ({ r with _value: float(v: r.elapsed) }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"gap\")",
          "refId": "A"
        }
      ],
      "title": "Inter-request gap (mean per window, ms)",
      "type": "timeseries"
    }
